rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }

    // Users Collection
    match /users/{userId} {
      // Allow authenticated users to read profiles
      allow read: if isAuthenticated();

      // Allow users to create their own user document (or admin)
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin())
      );

      // Allow users to update their own document
      // Prevent non-admin users from self-promoting to admin, or setting isEmployerVerified / isKycVerified
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin()) &&
        (!('isEmployerVerified' in request.resource.data) || request.resource.data.isEmployerVerified == resource.data.isEmployerVerified || isAdmin()) &&
        (!('isKycVerified' in request.resource.data) || request.resource.data.isKycVerified == resource.data.isKycVerified || isAdmin())
      );

      allow delete: if isAdmin();
    }

    // Applications Collection
    match /applications/{appId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.candidateId == request.auth.uid ||
        (exists(/databases/$(database)/documents/job_posts/$(resource.data.jobId)) && 
         get(/databases/$(database)/documents/job_posts/$(resource.data.jobId)).data.postedBy == request.auth.uid)
      );

      allow create: if isAuthenticated() &&
        request.resource.data.candidateId == request.auth.uid &&
        request.auth.token.email_verified == true;

      allow update: if isAdmin() || (isAuthenticated() && (
        resource.data.candidateId == request.auth.uid ||
        (exists(/databases/$(database)/documents/job_posts/$(resource.data.jobId)) && 
         get(/databases/$(database)/documents/job_posts/$(resource.data.jobId)).data.postedBy == request.auth.uid)
      ));

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.candidateId == request.auth.uid);
    }

    // Job Posts Collection
    match /job_posts/{jobId} {
      allow read: if true;

      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.postedBy == request.auth.uid
      );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.postedBy == request.auth.uid &&
        (!('postedBy' in request.resource.data) || request.resource.data.postedBy == resource.data.postedBy)
      );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.postedBy == request.auth.uid);
    }

    // Saved Jobs Collection
    match /saved_jobs/{savedId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Verification Requests Collection
    match /verification_requests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Subscriptions Collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.reporterUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit Logs Collection
    match /audit_logs/{auditId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
